# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Your OpenRouter key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# The model used to judge answers, e.g. a cheap fast model chosen with `npm run test:judge`
OPENROUTER_MODEL=

# Your deployed site URL (sent to OpenRouter as the referer). Optional.
SITE_URL=http://localhost:3000

# Set to false to switch AI judging off; the games fall back to built-in matching.
AI_JUDGE_ENABLED=true

# Neon Postgres connection string. Added automatically in Vercel when you connect the database.
DATABASE_URL=


# Password for /admin.html. Use a long random value and keep it secret.
ADMIN_KEY=
